# Copy to env/.env and fill locally. Never place this configuration in demofinal/.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=
PUBLIC_ORIGIN=http://127.0.0.1:8898

# Optional Firebase web config. The service account is specified separately
# through the process environment's GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
